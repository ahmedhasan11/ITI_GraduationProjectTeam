<script>
    // quantity start
    function updateTotal(medicineId, unitPrice) {
        const input = document.getElementById(`number-${medicineId}`);
        const total = document.getElementById(`total-${medicineId}`);

        let value = parseInt(input.value) || 0;
        total.textContent = (value * unitPrice).toFixed(2); // update row total

        // بعد ما نحدّث row واحد، نحدّث SubTotal كله
        updateSubTotal();
    }

    function increaseValue(medicineId, unitPrice) {
        const input = document.getElementById(`number-${medicineId}`);
        let value = parseInt(input.value) || 0;
        input.value = value + 1;
        updateTotal(medicineId, unitPrice);
    }

    function decreaseValue(medicineId, unitPrice) {
        const input = document.getElementById(`number-${medicineId}`);
        let value = parseInt(input.value) || 0;
        if (value > 1) {
            input.value = value - 1;
            updateTotal(medicineId, unitPrice);
        }
    }

    // تحديث SubTotal
    function updateSubTotal() {
        let subtotal = 0;

        // نعدّي على كل الـ totals الخاصة بالأدوية
        document.querySelectorAll("[id^='total-']").forEach(el => {
            subtotal += parseFloat(el.textContent) || 0;
        });

        // نعرض الناتج
        document.getElementById("subtotal").innerText = subtotal.toFixed(2);

        // لو عندك delivery fee مثلًا
        let delivery = 20.00; // ثابت أو ممكن تجيبه ديناميك
        document.getElementById("total").innerText = (subtotal + delivery).toFixed(2);
    }

    // لما الصفحة تفتح أول مرة
    window.addEventListener("load", updateSubTotal);
    // quantity end
</script>



<!-- [Page Specific JS] end -->
